[Unit]
Description=Gmail Pub/Sub listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=claude
WorkingDirectory=/opt/gmail-listener
EnvironmentFile=/opt/gmail-listener/.env
ExecStart=/opt/gmail-listener/.venv/bin/python /opt/gmail-listener/listener.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
