# Google Cloud project that owns the Pub/Sub topic
GOOGLE_CLOUD_PROJECT=my-gmail-listener-project

# Fully-qualified topic name used in users.watch()
PUBSUB_TOPIC=projects/my-gmail-listener-project/topics/gmail-notifications

# Pull subscription your listener process reads from
PUBSUB_SUBSCRIPTION=projects/my-gmail-listener-project/subscriptions/gmail-notifications-sub

# "me" works if credentials.json belongs to the mailbox owner; otherwise use the address
GMAIL_USER=me

# Restrict notifications to these labels (comma-separated). Empty = all changes.
WATCH_LABEL_IDS=INBOX

# File paths (relative to this directory unless absolute)
OAUTH_CLIENT_SECRET_FILE=credentials.json
OAUTH_TOKEN_FILE=token.json
STATE_DB_FILE=state.sqlite3
